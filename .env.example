# ============================================
# Backend - E-Commerce Log Generator
# Copiar a .env y completar con tus credenciales
# ============================================

ENVIRONMENT=dev
SERVER_PORT=8000

# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu-access-key-aqui
AWS_SECRET_ACCESS_KEY=tu-secret-key-aqui

# CloudWatch
LOG_GROUP_NAME=/kiro/microservices/backend

# Agente Carmen - webhook para notificación automática de errores
AGENT_WEBHOOK_URL=http://localhost:8001/webhook
