# ============================================
# Kiro Monitor Agent - Backend Configuration
# ============================================
# Copiar este archivo a .env: copy .env.example .env

# AWS Configuration (mock para desarrollo local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-key
AWS_SECRET_ACCESS_KEY=mock-secret

# App
ENVIRONMENT=dev
SERVER_PORT=8080
LOG_LEVEL=INFO

# CORS (orígenes permitidos, formato JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# CloudWatch
CLOUDWATCH_LOG_GROUP_PREFIX=/ecs/kiro-

# DynamoDB Tables
DYNAMODB_KNOWLEDGE_TABLE=KnowledgeTable
DYNAMODB_TICKETS_TABLE=TicketsTable
DYNAMODB_INCIDENTS_TABLE=IncidentsTable

# Agent (repo kiro-agent endpoint)
AGENT_ENDPOINT=http://localhost:8081
