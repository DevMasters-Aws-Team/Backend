{
  "mcpServers": {
    "aws-docs": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": ["search_documentation", "read_documentation"]
    },
    "cloudwatch-logs": {
      "command": "python",
      "args": ["src/mcp/cloudwatch_server.py"],
      "env": {
        "AWS_REGION": "us-east-1",
        "LOG_GROUP_NAME": "/kiro/microservices/backend"
      },
      "disabled": false,
      "autoApprove": ["get_recent_errors", "get_logs_by_service", "get_log_stats"]
    }
  }
}
